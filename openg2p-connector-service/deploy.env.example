# Connector Service container runtime example.
# Copy to your secret manager / deployment system and replace placeholders.

# --- API process ---
CONNECTOR_APP_HOST=0.0.0.0
CONNECTOR_APP_PORT=8050
CONNECTOR_LOG_LEVEL=INFO

# --- Connector database (required) ---
CONNECTOR_DB_DRIVER=postgresql+asyncpg
CONNECTOR_DB_HOSTNAME=postgres
CONNECTOR_DB_PORT=5432
CONNECTOR_DB_USERNAME=connector
CONNECTOR_DB_PASSWORD=change-me
CONNECTOR_DB_DBNAME=connector

# --- Registry Partner API target (required) ---
# Base URL only. The connector appends /partner/ingest_data itself.
CONNECTOR_PARTNER_INGEST_BASE_URL=http://registry-partner-api:8002
CONNECTOR_PARTNER_INGEST_TIMEOUT=30

# --- Redis / Celery (required for worker and beat) ---
CONNECTOR_CELERY_BROKER_URL=redis://redis:6379/1
CONNECTOR_CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Webhook defaults ---
CONNECTOR_WEBHOOK_DEFAULT_SECRET=

# --- Worker behavior ---
CONNECTOR_WORKER_MAX_ATTEMPTS=5
CONNECTOR_GLOBAL_MAX_IN_FLIGHT=50

# --- Production-safe defaults ---
CONNECTOR_STORE_RUN_PAYLOADS=false
CONNECTOR_RUN_PAYLOAD_MAX_BYTES=262144
CONNECTOR_VALIDATE_MAPPED_PAYLOAD=false

# --- CORS ---
# Only needed when the standalone Connector UI talks to this API from a browser.
CONNECTOR_CORS_ORIGINS=

# --- Optional rate limiting ---
CONNECTOR_WEBHOOK_RATE_LIMIT_ENABLED=false
CONNECTOR_WEBHOOK_RATE_LIMIT_MAX=100
CONNECTOR_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional metrics ---
# Build the image with CONNECTOR_PIP_EXTRAS=metrics before enabling.
CONNECTOR_METRICS_ENABLED=false
CONNECTOR_METRICS_PATH=/metrics

# --- Optional metadata dropdowns for the Connector UI ---
CONNECTOR_MASTER_DATA_DB_DSN=
CONNECTOR_REGISTRY_DB_DSN=

# --- Enterprise polling ---
CONNECTOR_STRICT_INCREMENTAL=true
CONNECTOR_FULL_SCAN_ON_INCREMENTAL_UNSUPPORTED=false

# --- Deprecated ODK fallbacks ---
# Keep blank unless you still rely on the old global ODK config.
CONNECTOR_ODK_CENTRAL_BASE_URL=
CONNECTOR_ODK_CENTRAL_EMAIL=
CONNECTOR_ODK_CENTRAL_PASSWORD=
CONNECTOR_ODK_POLL_INTERVAL_SECONDS=300

# --- Optional observability ---
CONNECTOR_OTEL_ENABLED=false
