# --- Connector Service ---
CONNECTOR_APP_HOST=0.0.0.0
CONNECTOR_APP_PORT=8050
CONNECTOR_LOG_LEVEL=INFO

# Database (connector-local, NOT the registry DB)
CONNECTOR_DB_DRIVER=postgresql+asyncpg
CONNECTOR_DB_HOSTNAME=localhost
CONNECTOR_DB_PORT=5432
CONNECTOR_DB_USERNAME=postgres
CONNECTOR_DB_PASSWORD=password
CONNECTOR_DB_DBNAME=connector

# Registry partner ingest endpoint (Mode A target)
# NOTE: this is the Registry PARTNER API (default :8002), not the Staff Portal API (:8000).
CONNECTOR_PARTNER_INGEST_BASE_URL=http://localhost:8002
CONNECTOR_PARTNER_INGEST_TIMEOUT=30

# Celery / Redis
CONNECTOR_CELERY_BROKER_URL=redis://localhost:6379/1
CONNECTOR_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Global webhook signing secret (connectors can override per-definition)
CONNECTOR_WEBHOOK_DEFAULT_SECRET=

# DEPRECATED: ODK Central globals — migrate to per-connector source_config_json
CONNECTOR_ODK_CENTRAL_BASE_URL=
CONNECTOR_ODK_CENTRAL_EMAIL=
CONNECTOR_ODK_CENTRAL_PASSWORD=
CONNECTOR_ODK_POLL_INTERVAL_SECONDS=300
# ODK Central HTTP client timeout (seconds) for OData polls and session login.
# Per-connector source_config_json.http_timeout_seconds overrides poll timeout only.
CONNECTOR_ODK_HTTP_TIMEOUT_SECONDS=60

# Worker
CONNECTOR_WORKER_MAX_ATTEMPTS=5

# Feature flags
CONNECTOR_OTEL_ENABLED=false
CONNECTOR_VALIDATE_MAPPED_PAYLOAD=false

# Persist per-run JSON snapshots (source / mapped / outbound) on ingestion_runs.
# Increases DB size and PII exposure — prefer false in production unless debugging.
CONNECTOR_STORE_RUN_PAYLOADS=true
# Max stored JSON bytes; larger payloads are truncated with _truncated in JSON.
CONNECTOR_RUN_PAYLOAD_MAX_BYTES=262144

# Backpressure
CONNECTOR_GLOBAL_MAX_IN_FLIGHT=50

# CORS (comma-separated origins for standalone Connector UI; empty = browser fetch blocked)
CONNECTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Webhook rate limiting (Redis sliding window)
CONNECTOR_WEBHOOK_RATE_LIMIT_ENABLED=false
CONNECTOR_WEBHOOK_RATE_LIMIT_MAX=100
CONNECTOR_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# Prometheus metrics (optional). prometheus_client is installed by default; enable with true.
CONNECTOR_METRICS_ENABLED=false
CONNECTOR_METRICS_PATH=/metrics

# Read-only DSNs for metadata dropdowns in the Connector UI. When blank the
# UI falls back to free-text inputs; set these locally to get partner /
# register dropdowns populated from the live registry.
CONNECTOR_MASTER_DATA_DB_DSN=
CONNECTOR_REGISTRY_DB_DSN=

# --- Enterprise polling / checkpointing ---
# When true, transports that cannot do server-side incremental queries
# raise a poll error instead of silently re-downloading every record.
# Enterprise default is true; per-connector source_config_json may
# override with "strict_incremental": false for low-volume / dev forms.
CONNECTOR_STRICT_INCREMENTAL=true
# Set true to permit a documented full-scan fallback when the configured
# incremental field returns 501 Not Implemented. Disabled by default so
# expensive full re-fetches are an explicit operational choice.
CONNECTOR_FULL_SCAN_ON_INCREMENTAL_UNSUPPORTED=false
