# Leave empty: Vite proxies API paths (no CORS).
VITE_CONNECTOR_API_BASE_URL=

# Proxy target (vite.config.ts). Examples:
#   http://127.0.0.1:8050                      (local Connector API — default)
#   https://connector.nsr.mowsa.gov.et         (UD prod — use npm run dev:ud)
#   https://connector.nsr.openg2p.org          (sandbox — use npm run dev:sandbox)
VITE_DEV_CONNECTOR_PROXY_TARGET=http://127.0.0.1:8050
