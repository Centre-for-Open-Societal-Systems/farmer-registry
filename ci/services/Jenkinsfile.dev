// Farmer-only optional releases. Connector installation remains fully paused.
pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }
    parameters {
        booleanParam(name: 'PREPARE_DEV', defaultValue: false,
            description: 'Build Farmer services and prepare a paused replacement; no ingestion activation or retirement.')
    }
    environment { AWS_REGION = 'ap-south-1' }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                dir('service-outcomes') { deleteDir() }
                script {
                    env.SOURCE_COMMIT = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    if (!(env.SOURCE_COMMIT ==~ /[0-9a-f]{40}/)) { error('Invalid source revision') }
                    env.IMAGE_TAG = env.SOURCE_COMMIT.take(12)
                }
                sh '''
                    set -eu
                    docker build -t "coss-ci/validation:$IMAGE_TAG" ci/jenkins
                    docker run --rm -v "$PWD:/repo:ro" "coss-ci/validation:$IMAGE_TAG" bash ci/jenkins/validate.sh
                '''
            }
        }
        stage('Build Farmer services') {
            when { expression { params.PREPARE_DEV } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-ecr-creds']]) {
                        script {
                            env.ECR_REGISTRY = sh(returnStdout: true, script: '''
                                set +x
                                account=$(aws sts get-caller-identity --query Account --output text)
                                case "$account" in *[!0-9]*|'') exit 1 ;; esac
                                test "${#account}" = 12
                                printf '%s.dkr.ecr.ap-south-1.amazonaws.com' "$account"
                            ''').trim()
                        }
                        sh '''
                            set -eu
                            set +x
                            # These two new image repositories belong only to Farmer's connector.
                            error_file=$(mktemp)
                            trap 'rm -f "$error_file"' EXIT
                            for role in api ui; do
                                repository="openg2p/registry-connector-$role"
                                if aws ecr describe-repositories --region "$AWS_REGION" --repository-names "$repository" >/dev/null 2>"$error_file"; then
                                    :
                                elif grep -q RepositoryNotFoundException "$error_file"; then
                                    aws ecr create-repository --region "$AWS_REGION" --repository-name "$repository" \
                                        --image-scanning-configuration scanOnPush=true >/dev/null
                                else
                                    echo 'Connector image repository check failed'
                                    exit 1
                                fi
                            done
                            bash ci/services/run-container.sh build --environment dev \
                                --registry "$ECR_REGISTRY" --output service-outcomes/build.json
                        '''
                    }
                }
                stash name: 'services-dev', includes: 'ci/**,helm/**,service-outcomes/build.json', excludes: 'helm/**/charts/**', useDefaultExcludes: false
            }
        }
        stage('Prepare paused replacement') {
            when { beforeAgent true; expression { params.PREPARE_DEV } }
            agent { label 'vpn-agent2' }
            steps {
                dir('services-dev-preparation') {
                    deleteDir()
                    unstash 'services-dev'
                    script {
                        def backupDirectory = "${pwd(tmp: true)}/connector-backup-${env.BUILD_NUMBER}"
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                            withCredentials([sshUserPrivateKey(credentialsId: 'farmer-new-dev-backup-ssh', keyFileVariable: 'BACKUP_SSH_KEY')]) {
                                withEnv(["CONNECTOR_BACKUP_DIRECTORY=${backupDirectory}"]) {
                                    sh 'bash ci/connector/fetch-backup-container.sh'
                                }
                            }
                        }
                        // Independent deploys still run when the connector backup fails.
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                            withCredentials([file(credentialsId: 'farmer-dev-kubeconfig', variable: 'KUBECONFIG')]) {
                                withEnv(["CONNECTOR_BACKUP_DIRECTORY=${backupDirectory}"]) {
                                    sh '''
                                        set -eu
                                        if ! test -d "$CONNECTOR_BACKUP_DIRECTORY"; then unset CONNECTOR_BACKUP_DIRECTORY; fi
                                        bash ci/services/run-container.sh deploy --environment dev \
                                            --registry "$ECR_REGISTRY" --input service-outcomes/build.json \
                                            --output service-outcomes/deploy.json
                                    '''
                                }
                            }
                        }
                    }
                    archiveArtifacts artifacts: 'service-outcomes/*.json', allowEmptyArchive: true
                }
            }
        }
    }
    post { always { archiveArtifacts artifacts: 'service-outcomes/*.json', allowEmptyArchive: true } }
}
