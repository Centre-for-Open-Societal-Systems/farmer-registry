# Local development outside Docker. In the compose stack these are set on the
# dashboard-ui service instead; see docker-compose.yml.

# The registry database — the one the Staff Portal's API writes to. Read only.
# Ports and credentials match local/.env (POSTGRES_PORT, REGISTRY_DB*).
DB_HOST=localhost
DB_PORT=55432
DB_USER=farmer_user
DB_PASSWORD=farmer_pass
DB_NAME=farmer

# Master Data holds the country pack: the administrative hierarchy behind the
# geography filters, and the unit counts behind the coverage panel. Host, port
# and credentials fall back to DB_* when unset, so only the database name is
# strictly required against the shared local server.
MD_DB_NAME=master_data
MD_DB_USER=master_data_user
MD_DB_PASSWORD=master_data_pass

# Baked into the client bundle at build time. The Back button only follows a
# returnUrl that points here, and falls back to this when none was supplied.
NEXT_PUBLIC_PORTAL_URL=http://portal.localtest.me:3000
