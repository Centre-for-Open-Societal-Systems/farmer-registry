{#- The Farmer reference that Crop and Livestock keep of a farmer, added to the
    farmer extension's DCI search response as one more top-level object. A
    Consent Manager scope of "farmer_reference" releases exactly this block.
    build_dci_template.py puts it before the response's closing brace. -#}
,
{%- set source = farmer -%}
{%- set hierarchy = (source.get('geo_code_hierarchy_json') or {}).get('hierarchy') or [] -%}
{%- set geo = namespace(region_id=none, zone_id=none, woreda_id=none, kebele_id=none,
                        region_name=none, zone_name=none, woreda_name=none, kebele_name=none) -%}
{%- for item in hierarchy -%}
{%- if item.get('level_mnemonic') == 'region' -%}{%- set geo.region_id = item.get('level_value_id') -%}{%- set geo.region_name = item.get('level_value_mnemonic') -%}
{%- elif item.get('level_mnemonic') == 'zone' -%}{%- set geo.zone_id = item.get('level_value_id') -%}{%- set geo.zone_name = item.get('level_value_mnemonic') -%}
{%- elif item.get('level_mnemonic') == 'woreda' -%}{%- set geo.woreda_id = item.get('level_value_id') -%}{%- set geo.woreda_name = item.get('level_value_mnemonic') -%}
{%- elif item.get('level_mnemonic') == 'kebele' -%}{%- set geo.kebele_id = item.get('level_value_id') -%}{%- set geo.kebele_name = item.get('level_value_mnemonic') -%}
{%- endif -%}
{%- endfor -%}
{%- set identifier = (source.get('foundational_id') or '') | string | replace(' ', '') -%}
{%- set approved = (source.get('last_approved_at') or '') | string -%}
{%- set phones = source.get('farmer_phone') or [] -%}
{%- set phone = phones[0].get('phone_number') if phones else none -%}
{%- set amharic = (source.get('language_spoken') or '') | string | upper == 'AMHARIC' -%}
"farmer_reference": {
  "source_record_id": {{ source.get('internal_record_id') | tojson }},
  "farmer_id": {{ source.get('functional_record_id') | tojson }},
  "fin": {{ (identifier if identifier | length == 12 else none) | tojson }},
  "fan": {{ (identifier if identifier | length == 16 else none) | tojson }},
  "approved_at": {{ ((approved if approved.endswith('Z') or '+' in approved else approved ~ 'Z') if approved else none) | tojson }},
  "record_status": {{ source.get('record_status') | tojson }},
  "first_name": {{ source.get('first_name') | tojson }},
  "middle_name": {{ source.get('middle_name') | tojson }},
  "last_name": {{ source.get('last_name') | tojson }},
  "first_name_amh": {{ (source.get('first_name_local') if amharic else none) | tojson }},
  "middle_name_amh": {{ (source.get('middle_name_local') if amharic else none) | tojson }},
  "last_name_amh": {{ (source.get('last_name_local') if amharic else none) | tojson }},
  "gender": {{ source.get('gender') | tojson }},
  "birth_date": {{ source.get('birth_date') | tojson }},
  "mobile_number": {{ phone | tojson }},
  "address_line_1": {{ source.get('address_line_1') | tojson }},
  "address_line_2": {{ source.get('address_line_2') | tojson }},
  "postal_code": {{ source.get('postal_code') | tojson }},
  "country_code": {{ source.get('country_code') | tojson }},
  "geo_lowest_level_value_id": {{ source.get('geo_lowest_level_value_id') | tojson }},
  "geo_code_hierarchy_json": {{ source.get('geo_code_hierarchy_json') | tojson }},
  "region_id": {{ geo.region_id | tojson }}, "region_name": {{ geo.region_name | tojson }},
  "zone_id": {{ geo.zone_id | tojson }}, "zone_name": {{ geo.zone_name | tojson }},
  "woreda_id": {{ geo.woreda_id | tojson }}, "woreda_name": {{ geo.woreda_name | tojson }},
  "kebele_id": {{ geo.kebele_id | tojson }}, "kebele_name": {{ geo.kebele_name | tojson }}
}
}
