# Farmer Registry — local Docker Compose environment.
#
# Derived from the openg2p-registry Helm chart (0.0.0-develop.383) values
# contract — the version pinned in helm/openg2p-farmer-registry/Chart.yaml and by
# ARG RP_VERSION in docker/*/Dockerfile. Every variable here corresponds to one
# the chart sets.
#
# ── Why *.localtest.me instead of localhost ──────────────────────────────────
# The Staff Portal login is a real OIDC round trip across three origins: the
# portal, the IAM staff API and Keycloak. IAM sets a session cookie the portal
# must also send, so all three need a COMMON PARENT DOMAIN — a cookie scoped to
# `localhost` cannot be shared with another host.
#
# `*.localtest.me` is public DNS that resolves to 127.0.0.1, so from the browser
# these names reach the published ports. Inside the compose network the same
# names are declared as network aliases and resolve to the containers. One URL
# therefore works from BOTH sides, which is what Keycloak's issuer and IAM's
# discovery call require.

# ── Release identity ─────────────────────────────────────────────────────────
# Chart equivalent: .Release.Name. Drives the registry DB/user names and the
# per-release Keycloak client id (global.authClientId = <release>-staff-portal).
RELEASE_NAME=farmer

# ── Host ports ───────────────────────────────────────────────────────────────
# Where a service is browser-facing its published port MUST equal its container
# port, so a single URL resolves identically from host and container.
STAFF_UI_PORT=3000
# The analytics dashboard the portal's Dashboard button opens. Browser-facing,
# so the published port equals the container port like the rest.
DASHBOARD_UI_PORT=3001
KEYCLOAK_PORT=8080
IAM_PORT=8000
MASTER_DATA_PORT=8010
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Internal-only services; published for docs/debugging convenience.
STAFF_API_PORT=8001
PARTNER_API_PORT=8002
POSTGRES_PORT=55432

# ── Public URLs (identical from browser and containers) ──────────────────────
STAFF_UI_HOST=portal.localtest.me
DASHBOARD_UI_HOST=dashboard.localtest.me
KEYCLOAK_HOST=keycloak.localtest.me
IAM_HOST=iam.localtest.me
MINIO_HOST=minio.localtest.me
COOKIE_DOMAIN=.localtest.me

# ── Database ─────────────────────────────────────────────────────────────────
# Local-only credentials. The chart takes these from Kubernetes Secrets that
# Helm generates; compose has no secret store, so they are plain here. They must
# be kept in step with local/postgres/init.sql, which creates the roles.
POSTGRES_PASSWORD=postgres
REGISTRY_DB=farmer
REGISTRY_DB_USER=farmer_user
REGISTRY_DB_PASSWORD=farmer_pass
MASTER_DATA_DB=master_data
MASTER_DATA_DB_USER=master_data_user
MASTER_DATA_DB_PASSWORD=master_data_pass
IAM_DB=iam
IAM_DB_USER=iam_user
IAM_DB_PASSWORD=iam_pass
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass
IDGEN_DB=farmer_idgenerator
IDGEN_DB_USER=farmer_idgenerator_user
IDGEN_DB_PASSWORD=farmer_idgenerator_pass

# ── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=staff
# Client IAM logs users in with (chart: commons-services `staff-portal`).
IAM_CLIENT_ID=staff-portal
IAM_CLIENT_SECRET=staff-portal-secret
# Per-release client that carries the registry role catalog
# (chart: global.authClientId = '{{ .Release.Name }}-staff-portal').
AUTH_CLIENT_ID=farmer-staff-portal
AUTH_CLIENT_SECRET=farmer-staff-portal-secret

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Bucket names are hard-set by the platform's DocumentBucket enum.
DEFAULT_BUCKET=default
TEMPLATE_BUCKET=templates
DOCUMENTS_BUCKET=documents

# ── Image tags ───────────────────────────────────────────────────────────────
# RP_VERSION must match ARG RP_VERSION in docker/*/Dockerfile and the
# openg2p-registry dependency in helm/openg2p-farmer-registry/Chart.yaml.
RP_VERSION=0.0.0-develop.383
MASTER_DATA_IMAGE=openg2p/master-data-api:1.1.3
IDGEN_IMAGE=openg2p/openg2p-id-generator:1.0.0
IAM_IMAGE=openg2p/iam-staff-portal-api:1.4.2

# ── Disabled integrations ────────────────────────────────────────────────────
# These chart defaults point at commons-services components that are not part
# of this local stack (AWE, audit manager, consent manager, partner signature
# validation, keymanager). Each is switched off via its documented flag rather
# than left pointing at a host that does not resolve.
AWE_ENABLED=false
AUDIT_ENABLED=false
PARTNER_SIGNATURE_VALIDATION_ENABLED=false
CONSENT_ENFORCEMENT_ENABLED=false
KEYMANAGER_AUTH_ENABLED=false
CRYPTO_BACKEND=local

# ── db-seed toggles ──────────────────────────────────────────────────────────
# Mirrors helm/openg2p-farmer-registry/values.yaml (registry.dbSeed.*), with one
# deliberate difference: LOAD_GEO_DATA.
#
# The chart leaves geo to the Master Data Service (geoSeed.countryPack in the
# openg2p-master-data chart). Nothing seeds MDS here, so the db-seed image's own
# geo loader is used instead — otherwise every geo dropdown is empty.
LOAD_GEO_DATA=true
# Farmer ships its own load_sample_data.py and seed-data/*.json in the db-seed
# image (see docker/db-seed/Dockerfile), so unlike the platform's reference
# registry this loads the ~500-row farmer demo set.
LOAD_SAMPLE_DATA=true
LOAD_IMAGES=true
LOAD_TEMPLATES=true
# Both copy from Master Data over HTTP. The local MDS starts empty — no country
# pack, no code lists — so there is nothing to copy and both would no-op. Left
# off rather than run against an empty source. Turn them on if you seed MDS.
LOAD_ATTRIBUTES=false
SYNC_GEO_WIDGETS=false
# Agriculture lists (crops, livestock) on top of the core ones, when
# LOAD_ATTRIBUTES is on.
ATTRIBUTE_DOMAINS=agriculture
