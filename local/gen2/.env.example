# Local-only defaults matching the existing shared volumes. No production keys.
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=postgres
KEYCLOAK_DB_PASSWORD=keycloak_pass
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=adminsecret
COMMONS_CLIENT_SECRET=dev-commons-client-secret
AUDIT_ENABLED=false
# Optional reporting profile: build the separately maintained dashboard API first.
DASHBOARD_API_IMAGE=openg2p-local/farmer-registry-dashboard-api:dev
