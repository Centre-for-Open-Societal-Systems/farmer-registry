#!/usr/bin/env python
"""Kubernetes transport shim for the isolated ECR hook script, never a real cluster."""
import base64,json,sys,urllib.request
import yaml

args=sys.argv[1:]
if args[:3]==['create','secret','docker-registry']:
    name=args[3]
    def option(key):
        flag='--'+key
        return next((a.split('=',1)[1] for a in args if a.startswith(flag+'=')),args[args.index(flag)+1] if flag in args else None)
    namespace=option('namespace');server=option('docker-server')
    assert namespace=='farmer' and name.startswith('farmer-registry-dashboard-')
    auth=base64.b64encode((option('docker-username')+':'+option('docker-password')).encode()).decode()
    config=json.dumps({'auths':{server:{'auth':auth}}}).encode()
    print(json.dumps({'apiVersion':'v1','kind':'Secret','metadata':{'name':name,'namespace':namespace},
        'type':'kubernetes.io/dockerconfigjson','data':{'.dockerconfigjson':base64.b64encode(config).decode()}}))
elif args==['apply','-f','-']:
    value=yaml.safe_load(sys.stdin);metadata=value['metadata']
    url='http://127.0.0.1:9137/api/v1/namespaces/'+metadata['namespace']+'/secrets/'+metadata['name']
    with urllib.request.urlopen(urllib.request.Request(url,data=json.dumps(value).encode(),method='PUT',headers={'Content-Type':'application/json'}),timeout=5) as response:
        assert response.status==200
else:
    sys.exit('Unsupported rehearsal kubectl command')
